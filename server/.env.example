# TradeFlow Server Environment Configuration
PORT=5002
NODE_ENV=development
CLIENT_URL=http://localhost:5174

# MongoDB Connection String
# Leave empty to automatically use in-memory replica set for zero-config local dev & tests
# Or provide local: mongodb://127.0.0.1:27017/tradeflow
# Or Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/tradeflow?retryWrites=true&w=majority
MONGODB_URI=

# Authentication
JWT_SECRET=tradeflow_jwt_secret_change_in_production_key_minimum_32_chars
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# Simulation Settings
SIMULATED_MARKET_ENABLED=true
DEMO_LIQUIDITY_INTERVAL_MS=3000
